generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum QuotationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
  CLOSED
}

enum AssistanceStatus {
  OPEN
  REVIEWED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AssignmentType {
  QUOTATION
  ASSISTANCE
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum MediaType {
  PHOTO
  VIDEO
  VOICE
  MESSAGE
  DOCUMENT
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
}

enum MemorialStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  HIDDEN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  CANCELLED
  COMPLETED
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  VIEW
  ASSIGN
  APPROVE
  REJECT
  SYSTEM
}

enum PolicyRecordStatus {
  ACTIVE
  GRACE
  LAPSED
}

enum FuneralCaseType {
  POLICY_COVERED
  WALK_IN_COVERAGE
}

enum FuneralCaseStatus {
  NEW
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CoverageReviewStatus {
  NOT_APPLICABLE
  PENDING
  ACTIVE
  GRACE
  LAPSED
  NOT_COVERED
}

enum WhatsAppCaseGroupStatus {
  NOT_REQUESTED
  PENDING
  CREATING
  ACTIVE
  FAILED
  CLOSED
}

enum WhatsAppCaseParticipantType {
  REPORTER
  STAFF
  RELATIVE
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  phoneNumber       String?   @unique @map("phone_number")
  email             String?   @unique
  passwordHash      String?   @map("password_hash")
  role              UserRole
  isActive          Boolean   @default(true) @map("is_active")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  customerProfile   CustomerProfile?
  adminProfile      Admin?
  auditLogsAsUser   AuditLog[] @relation("AuditLogActorUser")
  policyImportBatches PolicyImportBatch[]
  funeralCasesCreated FuneralCase[] @relation("FuneralCaseReporter")
  funeralCasesAssigned FuneralCase[] @relation("FuneralCaseAssignee")
  whatsappParticipantsAdded WhatsAppCaseParticipant[] @relation("WhatsAppParticipantAddedBy")

  @@map("users")
}

model CustomerProfile {
  id                   String                    @id @default(uuid()) @db.Uuid
  userId               String                    @unique @map("user_id") @db.Uuid
  firstName            String                    @map("first_name")
  lastName             String                    @map("last_name")
  phoneNumber          String?                   @map("phone_number")
  nationalIdOrPassport String?                   @map("national_id_or_passport")
  addressLine1         String?                   @map("address_line_1")
  addressLine2         String?                   @map("address_line_2")
  city                 String?
  province             String?
  country              String?
  dateOfBirth          DateTime?                 @map("date_of_birth")
  preferredLanguage   String                    @default("en") @map("preferred_language")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotationRequests    QuotationRequest[]
  assistanceRequests   FuneralAssistanceRequest[]
  memorials            Memorial[]
  marketplaceOrders    MarketplaceOrder[]
  mediaConsents        MediaConsent[]
  uploadedMemorialMedia MemorialMedia[]

  @@map("customer_profiles")
}

model Admin {
  id              String                     @id @default(uuid()) @db.Uuid
  userId          String                     @unique @map("user_id") @db.Uuid
  firstName       String                     @map("first_name")
  lastName        String                     @map("last_name")
  jobTitle        String?                    @map("job_title")
  isSuperAdmin    Boolean                    @default(false) @map("is_super_admin")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerRecords FuneralServiceProvider[]
  assignments     ProviderAssignment[]
  auditLogs       AuditLog[]

  @@map("admins")
}

model FuneralServiceProvider {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  providerType       String               @map("provider_type")
  contactPerson      String               @map("contact_person")
  phoneNumber        String               @map("phone_number")
  email              String?
  addressLine1       String               @map("address_line_1")
  addressLine2       String?              @map("address_line_2")
  city               String
  province           String
  country            String
  website            String?
  description        String?
  registrationNumber String?              @map("registration_number")
  isActive           Boolean              @default(true) @map("is_active")
  createdByAdminId   String               @map("created_by_admin_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  createdByAdmin     Admin                @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  assignments        ProviderAssignment[]

  @@unique([email])
  @@unique([registrationNumber])
  @@map("funeral_service_providers")
}

model FuneralPlan {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @unique
  description       String
  price             Decimal            @db.Decimal(10, 2)
  isPopular         Boolean            @default(false) @map("is_popular")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now()) @map("updated_at")

  quotationRequests QuotationRequest[]

  @@map("funeral_plans")
}

model QuotationRequest {
  id            String             @id @default(uuid()) @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  planId        String             @map("plan_id") @db.Uuid
  serviceType   String             @map("service_type")
  location      String
  estimatedTotal Decimal            @map("estimated_total") @db.Decimal(10, 2)
  status        QuotationStatus    @default(PENDING)
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @map("updated_at")

  customer      CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan          FuneralPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  assignments   ProviderAssignment[]

  @@map("quotation_requests")
}

model FuneralAssistanceRequest {
  id                   String              @id @default(uuid()) @db.Uuid
  customerId           String              @map("customer_id") @db.Uuid
  requestType          String              @map("request_type")
  urgencyLevel         String              @map("urgency_level")
  preferredServiceDate DateTime?           @map("preferred_service_date")
  serviceLocation      String              @map("service_location")
  description          String
  status               AssistanceStatus    @default(OPEN)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @default(now()) @map("updated_at")

  customer             CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignments          ProviderAssignment[]

  @@map("funeral_assistance_requests")
}

model ProviderAssignment {
  id                  String                    @id @default(uuid()) @db.Uuid
  assignmentType      AssignmentType            @map("assignment_type")
  providerId          String                    @map("provider_id") @db.Uuid
  quotationRequestId  String?                   @map("quotation_request_id") @db.Uuid
  assistanceRequestId String?                   @map("assistance_request_id") @db.Uuid
  assignedByAdminId   String                    @map("assigned_by_admin_id") @db.Uuid
  assignmentStatus    AssignmentStatus          @default(ASSIGNED) @map("assignment_status")
  notes               String?
  assignedAt          DateTime                  @default(now()) @map("assigned_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @default(now()) @map("updated_at")

  provider            FuneralServiceProvider    @relation(fields: [providerId], references: [id], onDelete: Restrict)
  quotationRequest    QuotationRequest?         @relation(fields: [quotationRequestId], references: [id], onDelete: Restrict)
  assistanceRequest   FuneralAssistanceRequest?  @relation(fields: [assistanceRequestId], references: [id], onDelete: Restrict)
  assignedByAdmin     Admin                     @relation(fields: [assignedByAdminId], references: [id], onDelete: Restrict)

  @@map("provider_assignments")
}

model Memorial {
  id                String          @id @default(uuid()) @db.Uuid
  customerId        String          @map("customer_id") @db.Uuid
  title             String
  slug              String          @unique
  deceasedFirstName String          @map("deceased_first_name")
  deceasedLastName  String          @map("deceased_last_name")
  dateOfBirth       DateTime?       @map("date_of_birth")
  dateOfDeath       DateTime?       @map("date_of_death")
  obituaryText      String?         @map("obituary_text")
  location          String?
  isPublic          Boolean         @default(true) @map("is_public")
  status            MemorialStatus  @default(DRAFT)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @map("updated_at")

  customer          CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  media             MemorialMedia[]
  messages          MemorialMessage[]
  mediaConsents     MediaConsent[]

  @@map("memorials")
}

model MemorialMedia {
  id                  String          @id @default(uuid()) @db.Uuid
  memorialId          String          @map("memorial_id") @db.Uuid
  mediaType           MediaType       @map("media_type")
  fileUrl             String          @map("file_url")
  caption             String?
  uploadedByCustomerId String          @map("uploaded_by_customer_id") @db.Uuid
  isApproved          Boolean         @default(false) @map("is_approved")
  consentStatus       ConsentStatus   @default(PENDING) @map("consent_status")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @default(now()) @map("updated_at")

  memorial            Memorial        @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  uploadedByCustomer  CustomerProfile @relation(fields: [uploadedByCustomerId], references: [id], onDelete: Restrict)

  @@map("memorial_media")
}

model MemorialMessage {
  id          String      @id @default(uuid()) @db.Uuid
  memorialId  String      @map("memorial_id") @db.Uuid
  authorName  String      @map("author_name")
  authorEmail String?     @map("author_email")
  messageText String      @map("message_text")
  isApproved  Boolean     @default(false) @map("is_approved")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @map("updated_at")

  memorial    Memorial    @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@map("memorial_messages")
}

model MediaConsent {
  id            String          @id @default(uuid()) @db.Uuid
  customerId    String          @map("customer_id") @db.Uuid
  memorialId    String?         @map("memorial_id") @db.Uuid
  consentScope  String          @map("consent_scope")
  consentStatus ConsentStatus   @default(PENDING) @map("consent_status")
  grantedAt     DateTime?       @map("granted_at")
  revokedAt     DateTime?       @map("revoked_at")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @default(now()) @map("updated_at")

  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  memorial      Memorial?       @relation(fields: [memorialId], references: [id], onDelete: SetNull)

  @@map("media_consents")
}

model MarketplaceProduct {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  category      String
  description   String
  price         Decimal         @db.Decimal(10, 2)
  sku           String          @unique
  stockQuantity Int             @default(0) @map("stock_quantity")
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @default(now()) @map("updated_at")

  orderItems    OrderItem[]

  @@map("marketplace_products")
}

model MarketplaceOrder {
  id              String          @id @default(uuid()) @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  status          OrderStatus     @default(PENDING)
  shippingAddress String?         @map("shipping_address")
  orderNotes      String?         @map("order_notes")
  totalAmount     Decimal         @default(0) @map("total_amount") @db.Decimal(10, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @map("updated_at")

  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           OrderItem[]

  @@map("marketplace_orders")
}

model OrderItem {
  id        String             @id @default(uuid()) @db.Uuid
  orderId   String             @map("order_id") @db.Uuid
  productId String             @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal            @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal            @map("line_total") @db.Decimal(10, 2)
  createdAt DateTime           @default(now()) @map("created_at")

  order     MarketplaceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model AuditLog {
  id          String          @id @default(uuid()) @db.Uuid
  actorUserId String?         @map("actor_user_id") @db.Uuid
  actorAdminId String?        @map("actor_admin_id") @db.Uuid
  entityType  String          @map("entity_type")
  entityId    String?         @map("entity_id") @db.Uuid
  actionType  AuditActionType @map("action_type")
  detailsJson Json?           @map("details_json")
  ipAddress   String?         @map("ip_address")
  createdAt   DateTime        @default(now()) @map("created_at")

  actorUser   User?           @relation("AuditLogActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAdmin  Admin?          @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Cemetery {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  addressLine1 String         @map("address_line_1")
  addressLine2 String?        @map("address_line_2")
  city         String
  province     String
  country      String
  latitude     Decimal        @db.Decimal(9, 6)
  longitude    Decimal        @db.Decimal(9, 6)
  contactPhone String?        @map("contact_phone")
  contactEmail String?        @map("contact_email")
  description  String?
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @map("updated_at")

  graveSections GraveSection[]
  burialRecords BurialRecord[]

  @@map("cemeteries")
}

model GraveSection {
  id              String        @id @default(uuid()) @db.Uuid
  cemeteryId      String        @map("cemetery_id") @db.Uuid
  sectionName     String        @map("section_name")
  sectionCode     String        @map("section_code")
  description     String?
  totalGraves     Int?          @map("total_graves")
  availableGraves Int?          @map("available_graves")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @map("updated_at")

  cemetery        Cemetery      @relation(fields: [cemeteryId], references: [id], onDelete: Restrict)
  burialRecords   BurialRecord[]

  @@unique([cemeteryId, sectionCode])
  @@map("grave_sections")
}

model BurialRecord {
  id                String       @id @default(uuid()) @db.Uuid
  cemeteryId        String       @map("cemetery_id") @db.Uuid
  graveSectionId    String       @map("grave_section_id") @db.Uuid
  deceasedFirstName String       @map("deceased_first_name")
  deceasedLastName  String       @map("deceased_last_name")
  burialDate        DateTime?    @map("burial_date")
  plotNumber        String?      @map("plot_number")
  graveNumber       String?      @map("grave_number")
  memorialNote      String?      @map("memorial_note")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @map("updated_at")

  cemetery          Cemetery     @relation(fields: [cemeteryId], references: [id], onDelete: Restrict)
  graveSection      GraveSection @relation(fields: [graveSectionId], references: [id], onDelete: Restrict)

  @@map("burial_records")
}

// ---- SMS / WhatsApp alerts (see src/alerts) ----

enum AlertChannel {
  SMS
  WHATSAPP
}

enum AlertOutboxStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  BLOCKED
}

/// One outbound message. The worker claims rows where status = QUEUED and scheduled_for <= now.
model AlertOutbox {
  id                String            @id @default(uuid()) @db.Uuid
  channel           AlertChannel
  event             String
  recipient         String            // E.164
  templateId        String            @map("template_id")
  body              String
  params            String[]
  status            AlertOutboxStatus @default(QUEUED)
  provider          String?
  providerMessageId String?           @map("provider_message_id")
  attempts          Int               @default(0)
  error             String?
  blockedReason     String?           @map("blocked_reason")
  dedupeKey         String            @map("dedupe_key")
  scheduledFor      DateTime          @map("scheduled_for")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([status, scheduledFor])
  @@index([dedupeKey])
  @@index([provider, providerMessageId])
  @@map("alert_outbox")
}

/// A person's per-event, per-channel opt-in. No row means "off".
model AlertPreference {
  userId    String       @map("user_id") @db.Uuid
  event     String
  channel   AlertChannel
  enabled   Boolean      @default(false)
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@id([userId, event, channel])
  @@map("alert_preferences")
}

/// Numbers that replied STOP, per channel. Checked before every send.
model AlertOptOut {
  phone     String
  channel   AlertChannel
  createdAt DateTime     @default(now()) @map("created_at")

  @@id([phone, channel])
  @@map("alert_opt_outs")
}

// ---- WhatsApp bridge (ported from Kuwana; one company-owned session) ----

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTING
  AWAITING_SCAN
  CONNECTED
  RECONNECTING
  ERROR
}

/// The state of the paired WhatsApp session. The bridge writes it; the API only reads it.
/// There is one row, keyed "company" (Kuwana keyed one per user).
model WhatsAppConnection {
  sessionKey       String                   @id @map("session_key")
  status           WhatsAppConnectionStatus @default(DISCONNECTED)
  phone            String?
  jid              String?
  qrCode           String?                  @map("qr_code")
  pairingCode      String?                  @map("pairing_code")
  qrExpiresAt      DateTime?                @map("qr_expires_at")
  pairingExpiresAt DateTime?                @map("pairing_expires_at")
  connectedAt      DateTime?                @map("connected_at")
  lastActiveAt     DateTime                 @default(now()) @map("last_active_at")
  errorMessage     String?                  @map("error_message")
  sessionDir       String?                  @map("session_dir")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@index([status])
  @@map("whatsapp_connections")
}

/// Append-only audit trail of bridge activity (sessions, queue, settings). Codes are masked before storing.
model WhatsAppEvent {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  status    String
  phone     String?
  jid       String?
  details   String?
  metadata  Json?
  latencyMs Int?     @map("latency_ms")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([phone, createdAt])
  @@index([createdAt])
  @@map("whatsapp_events")
}

/// Small key-value settings: the WhatsApp master switch, SMS provider and sender ID, template overrides.
/// Secrets (API keys) never go here; they stay in environment variables.
model AppSetting {
  key       String   @id
  value     String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Short-lived, one-use mobile OTP challenge. Only a keyed hash of the code is stored.
model OtpChallenge {
  id         String   @id @default(uuid()) @db.Uuid
  phone      String
  purpose    String
  codeHash   String   @map("code_hash")
  attempts   Int      @default(0)
  expiresAt  DateTime @map("expires_at")
  lastSentAt DateTime @default(now()) @map("last_sent_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([phone, purpose])
  @@index([expiresAt])
  @@map("otp_challenges")
}

/// Current policy data imported by Fidelity administrators from a validated workbook.
model PolicyRecord {
  policyNumber         String             @id @map("policy_number")
  holderName           String             @map("holder_name")
  phoneNumber          String             @map("phone_number")
  status               PolicyRecordStatus
  planName             String             @map("plan_name")
  coverAmount          Decimal            @map("cover_amount") @db.Decimal(12, 2)
  monthlyPremium       Decimal            @map("monthly_premium") @db.Decimal(12, 2)
  startDate            DateTime           @map("start_date") @db.Date
  monthsPaid           Int                @map("months_paid")
  waitingPeriodMonths  Int                @map("waiting_period_months")
  sourceBatchId        String             @map("source_batch_id") @db.Uuid
  importedAt           DateTime           @default(now()) @map("imported_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  sourceBatch          PolicyImportBatch  @relation(fields: [sourceBatchId], references: [id], onDelete: Restrict)
  members              PolicyCoveredMember[]
  funeralCases         FuneralCase[]

  @@index([phoneNumber])
  @@map("policy_records")
}

/// Server-authoritative intake and case coordination record.
model FuneralCase {
  id                    String               @id @default(uuid()) @db.Uuid
  reference             String               @unique
  caseType              FuneralCaseType      @map("case_type")
  status                FuneralCaseStatus    @default(NEW)
  reporterUserId        String               @map("reporter_user_id") @db.Uuid
  reporterName          String               @map("reporter_name")
  contactPhone          String               @map("contact_phone")
  deceasedName          String?              @map("deceased_name")
  dateOfDeath           DateTime?            @map("date_of_death") @db.Date
  serviceLocation       String?              @map("service_location")
  funeralAt             DateTime?            @map("funeral_at")
  funeralLocation       String?              @map("funeral_location")
  requestedPlan         String?              @map("requested_plan")
  applicationChannel    String?              @map("application_channel")
  applicationLocation  String?              @map("application_location")
  requestedServices     String[]             @default([]) @map("requested_services")
  policyNumber          String?              @map("policy_number")
  coverageReviewStatus  CoverageReviewStatus @default(NOT_APPLICABLE) @map("coverage_review_status")
  assignedStaffUserId   String?              @map("assigned_staff_user_id") @db.Uuid
  whatsappConsentAt     DateTime?            @map("whatsapp_consent_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  reporter              User                 @relation("FuneralCaseReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  assignedStaff         User?                @relation("FuneralCaseAssignee", fields: [assignedStaffUserId], references: [id], onDelete: SetNull)
  policy                PolicyRecord?        @relation(fields: [policyNumber], references: [policyNumber], onDelete: Restrict)
  whatsappGroup         WhatsAppCaseGroup?
  whatsappParticipants  WhatsAppCaseParticipant[]

  @@index([reporterUserId, createdAt])
  @@index([status, createdAt])
  @@index([assignedStaffUserId, status])
  @@map("funeral_cases")
}

model WhatsAppCaseGroup {
  id          String                  @id @default(uuid()) @db.Uuid
  caseId      String                  @unique @map("case_id") @db.Uuid
  status      WhatsAppCaseGroupStatus @default(PENDING)
  groupJid    String?                 @unique @map("group_jid")
  groupName   String                  @map("group_name")
  error       String?
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  funeralCase FuneralCase              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  participants WhatsAppCaseParticipant[]

  @@index([status, updatedAt])
  @@map("whatsapp_case_groups")
}

model WhatsAppCaseParticipant {
  id                 String                       @id @default(uuid()) @db.Uuid
  caseId             String                       @map("case_id") @db.Uuid
  groupId            String?                      @map("group_id") @db.Uuid
  phoneNumber        String                       @map("phone_number")
  displayName        String                       @map("display_name")
  relationship       String?
  participantType    WhatsAppCaseParticipantType  @map("participant_type")
  consentAt          DateTime?                    @map("consent_at")
  addedAt            DateTime?                    @map("added_at")
  removedAt          DateTime?                    @map("removed_at")
  addedByUserId      String?                      @map("added_by_user_id") @db.Uuid
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  funeralCase        FuneralCase                  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  group              WhatsAppCaseGroup?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedBy            User?                        @relation("WhatsAppParticipantAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([caseId, phoneNumber])
  @@index([groupId])
  @@index([caseId, participantType])
  @@map("whatsapp_case_participants")
}

model PolicyCoveredMember {
  id              String       @id @default(uuid()) @db.Uuid
  policyNumber    String       @map("policy_number")
  name            String
  relationship    String
  share           Decimal?     @db.Decimal(5, 2)

  policy          PolicyRecord @relation(fields: [policyNumber], references: [policyNumber], onDelete: Cascade)

  @@unique([policyNumber, name])
  @@map("policy_covered_members")
}

/// Staged preview payload; applying a batch is a separate, audited action.
model PolicyImportBatch {
  id                String         @id @default(uuid()) @db.Uuid
  uploadedByUserId  String         @map("uploaded_by_user_id") @db.Uuid
  fileName          String         @map("file_name")
  layout            String
  rowsRead          Int            @map("rows_read")
  policiesAdded     Int            @map("policies_added")
  policiesUpdated   Int            @map("policies_updated")
  payload           Json
  status            String         @default("PREVIEW")
  expiresAt         DateTime       @map("expires_at")
  committedAt       DateTime?      @map("committed_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  uploadedBy        User           @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  policies          PolicyRecord[]

  @@index([uploadedByUserId, createdAt])
  @@index([status, expiresAt])
  @@map("policy_import_batches")
}

model OperationCase {
  id              String   @id @default(uuid())
  reference       String   @unique
  caseType        String   @map("case_type")
  customerName    String   @map("customer_name")
  phone           String
  deceasedName    String   @map("deceased_name")
  dateOfDeath     String   @map("date_of_death")
  serviceLocation String   @map("service_location")
  branch          String   @default("Harare")
  funeralAt       String?  @map("funeral_at")
  funeralLocation String   @map("funeral_location")
  coordinator     String   @default("")
  priority        String   @default("standard")
  priorityReason  String   @default("") @map("priority_reason")
  closureReason   String?  @map("closure_reason")
  status          String   @default("new")
  policyReference String?  @map("policy_reference")
  intakeChannel   String?  @map("intake_channel")
  postMortem      String   @default("pending") @map("post_mortem")
  stages          Json     @default("[]")
  checklist       Json     @default("[]")
  documents       Json     @default("[]")
  movements       Json     @default("[]")
  quotes          Json     @default("[]")
